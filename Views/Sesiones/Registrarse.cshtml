@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="auth">
    <aside class="auth-brand">
        <a class="lp-brand" href='@Url.Action("Index", "Home")' aria-label="Volver al inicio"><img src="~/img/logo.svg" alt="Bridge"><span><span class="brand-name">BRIDGE</span><span class="brand-tag bloque">Conservando la vida</span></span></a>
        <div class="stack gap-14">
            <h1 class="lp-h2"><span class="thin">No estás solo.</span> <span class="bold">Estamos para vos.</span></h1>
            <p class="lp-lead hide-sm">Creá tu cuenta y armá el grupo de cuidado en pocos minutos. Después sumás a la familia y a quienes cuidan.</p>
        </div>
        <p class="script hide-sm">Juntos somos puentes</p>
        <div class="hero-wave"></div>
    </aside>
    <div class="auth-form">
        <form class="auth-card" action='@Url.Action("Registrarse", "Sesiones")' method="post" novalidate>
            <div>
                <div class="eyebrow">Crear cuenta</div>
                <h2 class="auth-title">Empecemos</h2>
                <p class="muted">¿Ya tenés cuenta? <a href='@Url.Action("Login", "Sesiones")'>Ingresá</a></p>
            </div>
            <div class="field">
                <span class="label">Plan</span>
                <div class="seg">
                    <input type="radio" id="su-plan-gratis" checked disabled>
                    <label for="su-plan-gratis">Gratis</label>
                </div>
                <p class="small muted">Gratis para siempre. No incluye el asistente con IA. 1 adulto mayor · vos y un acompañante · sin IA.</p>
            </div>
            <div class="form-grid">
                <div class="field">
                    <label for="su-first">Nombre</label>
                    <input id="su-first" class="input" type="text" name="nombre" value="@ViewBag.Nombre" placeholder="Ej.: Martín" autocomplete="given-name">
                </div>
                <div class="field">
                    <label for="su-last">Apellido</label>
                    <input id="su-last" class="input" type="text" name="apellido" value="@ViewBag.Apellido" placeholder="Ej.: Gómez" autocomplete="family-name">
                </div>
            </div>
            <div class="field">
                <label for="su-email">Email</label>
                <input id="su-email" class="input" type="email" name="email" value="@ViewBag.Email" placeholder="nombre@@ejemplo.com" autocomplete="email">
            </div>
            <div class="field">
                <label for="su-pass">Contraseña</label>
                <input id="su-pass" class="input" type="password" name="contrasena" placeholder="Al menos 8 caracteres" autocomplete="new-password">
            </div>
            <label class="row small"><input type="checkbox" id="su-terms" name="aceptaTerminos" value="true" checked="@ViewBag.AceptaTerminos"> Acepto los términos y la política de privacidad</label>
            <p class="form-error" role="alert">@ViewBag.Error</p>
            <button class="btn lg" type="submit">Crear cuenta</button>
        </form>
    </div>
</div>
