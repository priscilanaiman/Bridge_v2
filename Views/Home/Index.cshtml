        <a class="lp-brand" href='@Url.Action("Index", "Home")' aria-label="Bridge"><img src="~/img/logo.svg" alt="Bridge"><span><span class="brand-name">BRIDGE</span><span class="brand-tag bloque">Conservando la vida</span></span></a>
        <nav class="lp-links" aria-label="Secciones">
            <a href="#producto">Producto</a>
